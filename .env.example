# Copy this file to .env. All keys are server-side only.
# FAL_KEY is needed for fal/VEED narration and video routes.
FAL_KEY=
# TAVILY_API_KEY powers public perception research in the app.
TAVILY_API_KEY=
# Official X API v2 app-only bearer token for public recent-post search.
X_BEARER_TOKEN=
# Alternative server-side X app credentials. The integration exchanges these
# for an app-only token when X_BEARER_TOKEN is not supplied.
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
# Official Reddit Data API credentials. Use an approved external OAuth client,
# or supply a short-lived server-side access token instead.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_ACCESS_TOKEN=
REDDIT_USER_AGENT=Roastr/0.1 (public-discourse research)
# OPENAI_API_KEY powers structured Roast Packet generation with GPT-5.6 Luna.
OPENAI_API_KEY=
# OPENROUTER_API_KEY optionally enables Grok as a challenger writer in the candidate arena.
OPENROUTER_API_KEY=
# Optional but recommended: higher GitHub API rate limit for repository extraction.
GITHUB_TOKEN=
# Optional: enable when adding Pioneer classifier/fine-tuning and offline Parallel benchmark flows.
PIONEER_API_KEY=
PARALLEL_API_KEY=
# Eval-only optional local/remote Ollama OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=240000
